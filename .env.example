# Токен бота от @BotFather
BOT_TOKEN=
# Твой Telegram user id. Можно оставить пустым: владельцем станет тот, кто первым нажмёт /start
OWNER_ID=
# Ключ для PWA и хоткея (генерирует scripts/setup.sh)
WEB_KEY=
WEB_PORT=8787

# Страховка при спящем ноуте (заполняет scripts/telethon_login.py)
TG_API_ID=
TG_API_HASH=
TG_INSURANCE_SESSION=

# Whisper (по умолчанию уже скачанная large-v3-turbo; для скорости: mlx-community/whisper-small-mlx)
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# OBSIDIAN_DIR=/Users/cucaramba/Documents/Obsidian storage/Продуктивность и привычки

# Apple Calendar (CalDAV). Пусто = синк выключен.
# Пароль — не обычный, а app-specific: appleid.apple.com -> Безопасность -> Пароли приложений
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
# ICLOUD_CALENDAR_NAME=Dungeon Tasks
